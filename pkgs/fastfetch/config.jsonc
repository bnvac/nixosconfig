// parajynx's fastfetch (and `neofetch`). Your own ~/.config/fastfetch/config.jsonc
// wins if you make one.
//
// One accent, everything else plain: "blue" is the terminal's colour 4, which
// `rice` sets to the accent it takes from your wallpaper. Change the wallpaper
// and the logo and labels follow it.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "color": { "1": "blue" },
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "blue", "title": "default", "separator": "default", "output": "default" },
    "key": { "width": 10 },
    "bar": { "char": { "elapsed": "━", "total": "─" }, "width": 12 },
    "percent": { "type": ["num"], "color": { "green": "default", "yellow": "yellow", "red": "red" } }
  },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}", "color": { "user": "default", "at": "90", "host": "blue" } },
    { "type": "custom", "format": "\u001b[90m────────────────────────────────────" },
    { "type": "os", "key": "system", "format": "parajynx · NixOS {version-id}" },
    { "type": "command", "key": "version", "shell": "/bin/sh",
      "text": "l=$(readlink /nix/var/nix/profiles/system) && n=${l#system-} && echo \"#${n%-link}\"" },
    { "type": "command", "key": "modules", "shell": "/bin/sh",
      "text": "[ -r /etc/nix2/modules ] && tr '\\n' ' ' < /etc/nix2/modules" },
    { "type": "kernel", "key": "kernel", "format": "{release}" },
    { "type": "uptime", "key": "uptime" },
    { "type": "packages", "key": "packages" },
    { "type": "wm", "key": "desktop", "format": "{pretty-name}" },
    { "type": "terminal", "key": "terminal" },
    { "type": "custom", "format": "" },
    { "type": "cpu", "key": "cpu", "format": "{name} ({cores-logical})" },
    { "type": "gpu", "key": "gpu", "format": "{name}" },
    { "type": "memory", "key": "memory" },
    { "type": "disk", "key": "disk", "folders": "/" },
    { "type": "battery", "key": "battery" }
  ]
}
